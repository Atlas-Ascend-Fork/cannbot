{
  "name": "cannbot-dsh",
  "version": "1.0.0-alpha.1",
  "description": "CANNBot DSH: Ascend development workbench with independently versioned workflow packages",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "files": [
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.1.1-rc.1 <0.3.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "dsh",
    "cannbot",
    "workbench",
    "ascend"
  ],
  "scripts": { "pack:plugin": "node ../../scripts/package.mjs --short" },
  "dependencies": {
    "@cannbot-plugin/cannbot-dsh": "1.0.0-alpha.1"
  }
}
