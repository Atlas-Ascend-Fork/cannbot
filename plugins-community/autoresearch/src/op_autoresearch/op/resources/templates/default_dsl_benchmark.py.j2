{% if is_ascend %}try:
    from op_autoresearch.op.verifier.profiler import profiler_npu
    profiler_available = True
except ImportError:
    profiler_available = False

def generated_benchmark_fn():
    return impl_model(*{{ inputs }})

if profiler_available:
    execution_time_us = profiler_npu(
        generated_benchmark_fn,
        warmup={{ warmup }},
        active={{ runs }},
        prof_dir_name=f"prof_generation_output_case_{case_idx}",
        keep_res=False,
        suppress_warnings=True,
        clear_l2_cache={{ clear_l2_cache }},
        dsl="other"{{ framework_arg }},
    )
    execution_time_ms = execution_time_us / 1000
    method = "profiler_npu"
else:
    import time
    start_time = time.time()
    for _ in range({{ total_runs }}):
        _ = generated_benchmark_fn()
        torch.npu.synchronize()
    end_time = time.time()
    execution_time_ms = (
        (end_time - start_time) * 1000 / {{ total_runs }}
    )
    method = "traditional_timing"
{% else %}import time

def generated_benchmark_fn():
    return impl_model(*{{ inputs }})

start_time = time.time()
for _ in range({{ total_runs }}):
    _ = generated_benchmark_fn()
    pass
end_time = time.time()
execution_time_ms = (
    (end_time - start_time) * 1000 / {{ total_runs }}
)
method = "traditional_timing"
{% endif %}
