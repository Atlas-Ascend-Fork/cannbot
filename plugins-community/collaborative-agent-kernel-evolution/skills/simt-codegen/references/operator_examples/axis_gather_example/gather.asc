// === Model B SIMT VF Bridge — Gather (axis-gather / np.take / GatherV2) ===
//
// out[a, j, c] = x[a, indices[j], c]   for a rank-3 x and 1-D indices, axis=1.
//
// Generated per skills/simt-codegen/ (Model B, per Pass 0 Q1→Q2→Q3→Q5).
// Structural patterns adapted from references/operator_examples/torch_gather_20_20/:
//   - grid-stride loop over output elements        (SKILL.md rule 8)
//   - immutable __gm__ const tiling pointer to VF  (SKILL.md rule 12)
//   - dim3() = threads-per-block, not grid size    (SKILL.md rule 11)
//   - OOB index bounds-guard before any x[] read
// The INDEX ADDRESSING is re-derived, not adapted: gather_20_20 implements
// torch.gather (index shape == output shape, one index read per output element).
// See SIMT_GAP_REPORT.md G5.

#include "kernel_operator.h"
#include "simt_api/asc_simt.h"
#include "simt_api/asc_fp16.h"
#include "simt_api/asc_bf16.h"
#include "gather_custom_tiling.h"

// ────────────────────────────────────────────────────────────────────────────
// Pass 1 — vf_pass (per-thread compute)
// ────────────────────────────────────────────────────────────────────────────
template <typename T, typename IndexT>
__simt_vf__ __launch_bounds__(256) inline void simt_gather_axis(
    __gm__ const T* x,                  // input  [outerSize, axisSize, innerSize]
    __gm__ const IndexT* indices,       // 1-D index tensor, length indexLen
    __gm__ T* y,                        // output [outerSize, indexLen, innerSize]
    __gm__ const GatherCustomTilingData* tg)
{
    const uint32_t total     = tg->totalElements;
    const uint32_t axisSize  = tg->axisSize;
    const uint32_t innerSize = tg->innerSize;
    const uint32_t indexLen  = tg->indexLen;

    // Sizes of one gathered slab, in the output and in the input respectively.
    const uint32_t outRowSize = indexLen * innerSize;   // elements per outer slice of y
    const uint32_t inRowSize  = axisSize * innerSize;   // elements per outer slice of x

    // Grid-stride so a bounded grid (host caps numBlocks) covers any output size.
    const uint32_t stride = gridDim.x * blockDim.x;
    for (uint32_t idx = blockIdx.x * blockDim.x + threadIdx.x; idx < total; idx += stride) {
        // Decompose the linear OUTPUT index into (outer, j, inner).
        // For axis-gather the gathered coordinate j comes from the output position;
        // there is no per-output-element index tensor to read.
        const uint32_t outer = idx / outRowSize;
        const uint32_t rem   = idx - outer * outRowSize;
        const uint32_t j     = rem / innerSize;
        const uint32_t inner = rem - j * innerSize;

        // One index read per gathered slab position (j), not per output element.
        int64_t indexValue = static_cast<int64_t>(indices[j]);

        // np.take / ONNX Gather allow negative indices — wrap before the guard.
        if (indexValue < 0) {
            indexValue += static_cast<int64_t>(axisSize);
        }
        if (indexValue < 0 || indexValue >= static_cast<int64_t>(axisSize)) {
            y[idx] = static_cast<T>(0);   // OOB guard → no OOB read / crash
            continue;
        }

        const uint32_t offset_in =
            outer * inRowSize + static_cast<uint32_t>(indexValue) * innerSize + inner;
        y[idx] = x[offset_in];
    }
}

// ────────────────────────────────────────────────────────────────────────────
// Pass 2 — entry_pass (SIMT dispatcher)
// ────────────────────────────────────────────────────────────────────────────
extern "C" __global__ __aicore__ void gather_custom(
    GM_ADDR x,
    GM_ADDR indices,
    GM_ADDR y,
    GM_ADDR workspace,   // NOT SIMT-writable — never passed to the VF (SKILL.md rule 7)
    GM_ADDR tiling)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);  // MANDATORY: else ld.lld "auto derivate failed"
    REGISTER_TILING_DEFAULT(GatherCustomTilingData);
    GET_TILING_DATA(td, tiling);

    // Immutable tiling pointer handed to the VF — no mutable __gm__ globals,
    // so no cold-launch race on the shape metadata (SKILL.md rule 12).
    __gm__ const GatherCustomTilingData* tg =
        reinterpret_cast<__gm__ const GatherCustomTilingData*>(tiling);

    // dim3(...) is threads-per-block, NOT the grid size (SKILL.md rule 11).
    // The grid comes from SetBlockDim(numBlocks) on the host.
#define GATHER_DISPATCH(T)                                                            \
    if (td.indexDtypeCode == 0)                                                       \
        asc_vf_call<simt_gather_axis<T, int32_t>>(dim3(td.threadsPerBlock),           \
            (__gm__ const T*)x, (__gm__ const int32_t*)indices, (__gm__ T*)y, tg);    \
    else                                                                              \
        asc_vf_call<simt_gather_axis<T, int64_t>>(dim3(td.threadsPerBlock),           \
            (__gm__ const T*)x, (__gm__ const int64_t*)indices, (__gm__ T*)y, tg);

    switch (td.dtypeCode) {
        case 0: { GATHER_DISPATCH(float); break; }
        case 1: { GATHER_DISPATCH(half); break; }
        case 2: { GATHER_DISPATCH(bfloat16_t); break; }
        case 3: { GATHER_DISPATCH(int32_t); break; }
    }
#undef GATHER_DISPATCH
}
